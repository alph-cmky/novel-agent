# OpenAI-compatible API configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Model selection
BUDGET_MODEL=deepseek-chat
QUALITY_MODEL=claude-sonnet-4-20250514

# Observability (optional). Default off — local counters still work.
# Enable with LANGFUSE_TRACING=1 after `uv sync --extra observability`.
# Do not set LANGFUSE_HOST; the SDK reads LANGFUSE_BASE_URL.
LANGFUSE_TRACING=0
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_CAPTURE_PROMPTS=0
